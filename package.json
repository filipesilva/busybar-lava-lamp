{
  "name": "busy-bar-lava-lamp",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive lava lamp on your Busy Bar",
  "author": "Filipe Silva",
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "build": "busy-cli build",
    "app:install": "busy-cli app install",
    "app:uninstall": "busy-cli app uninstall",
    "app:run": "busy-cli app run",
    "app:stop": "busy-cli app stop",
    "postinstall": "patch-package",
    "version": "node tools/version.mjs && git add src/appmeta/manifest.json"
  },
  "engines": {
    "node": ">=24 <26"
  },
  "devDependencies": {
    "@busy-app/cli": "^0.6.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "vite": "8.1.4"
  },
  "dependencies": {
    "@busy-app/busy-lib": "^0.21.1"
  },
  "license": "MIT"
}
